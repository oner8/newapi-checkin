# 复制为 .env 后填写：cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，不要把真实凭据提交进版本库。

# 面板写接口令牌。POST /api/run 需要请求头 X-Admin-Token: <PANEL_TOKEN>；
# 留空时只接受来自 127.0.0.1 的请求。
# 注意：Docker 部署下容器看到的来源是网桥网关（例如 172.18.0.1）而不是 127.0.0.1，
# 所以这里必须填上，否则从宿主机也触发不了 POST /api/run。
PANEL_TOKEN=

# Bark（iOS 推送）Key，在 Bark App 里获取。
BARK_KEY=

# 站点凭据之一：Cookie（适用于较老的 new-api 与大部分 fork）。
# 命名建议 SITE_<站点名大写蛇形>_COOKIE，在 config.yaml 里以 ${SITE_EXAMPLE_COOKIE} 引用。
SITE_EXAMPLE_COOKIE=

# 站点凭据之二：访问令牌 PAT（新版 new-api v1.0.0-rc.x / 上游 main 必须用这个，
# 那里浏览器已没有可复制的 session Cookie）。
# 面板路径：个人设置 → 账户管理 → 安全设置 → 生成令牌；在 config.yaml 里配 type: access_token。
SITE_EXAMPLE_TOKEN=
